# Copy to .env.local (never commit it) and fill in.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — user management and the create-admin script. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary → Dashboard (optional; without these, expense bills can't be attached)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Drive service account (optional; without these, "Create Directory" on a
# property is disabled). Share the parent folder with the service account first.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# Zoho CRM (optional; without these, OBC lines are entered by hand)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Your data centre — .in, .com, .eu, .com.au …
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in
